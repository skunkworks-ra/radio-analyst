{
  "minimumVersion": "2.1.261",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(pixi run check)",
      "Bash(pixi run test)",
      "Bash(pixi run test-unit)",
      "Bash(pixi run test-int)",
      "Bash(pixi install *)",
      "Bash(mkdir *)",
      "Bash(tar *)",
      "Bash(pixi run python *)",
      "Bash(pgrep *)",
      "Bash(nproc)",
      "Bash(ls *)",
      "Bash(du *)",
      "Bash(rm -f */table.lock)",
      "mcp__ms-inspect__*",
      "mcp__ms-modify__*",
      "mcp__ms-create__*",
      "Bash(nvidia-smi)",
      "Bash(nvidia-smi --query*)",
      "Bash(git merge-base *)",
      "Bash(podman ps)",
      "Bash(podman ps *)",
      "Bash(claude --version)",
      "Bash(distrobox list*)",
      "Bash(podman images *)",
      "Bash(git check-ignore *)"
    ]
  }
}
